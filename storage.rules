rules_version = '2';

// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Photos uploaded to album buckets.
    // Any signed-in user can read (parents need to see their kids' photos);
    // only signed-in users can write (the app limits writes to admins client-side).
    // Tighter rule (admin-only) would require a Cloud Function bridge since
    // Storage rules cannot query Firestore.
    match /albums/{albumId}/{photoFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
