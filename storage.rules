rules_version = '2';

// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Photos uploaded to album buckets.
    // Read: any signed-in user (parents need to see their kids' photos).
    // Write: signed-in + image + size cap. Storage rules can't query Firestore,
    // so the authoritative dept-access check lives on the matching /photos/{id}
    // Firestore rule — a bare upload here without a matching Firestore doc
    // ends up unreferenced.
    match /albums/{albumId}/{photoFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Post attachments (images + arbitrary files). Read by any signed-in user;
    // writes are signed-in + size-capped (no content-type restriction so PDFs/
    // docs are allowed). Firestore /posts rules remain the access authority.
    match /posts/{kgId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Per-child documents (e.g. signed contracts). The object URL is the
    // secret — discovery is gated by the access-controlled /documents/{id}
    // Firestore doc, which only admins + the child's parents can read.
    match /documents/{kgId}/{childId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Conversation attachments (images + files sent in chat messages).
    // The download URL is the secret — Firestore rules on /conversations/{cid}/messages
    // already prevent non-participants from reading any message that contains the URL.
    match /conversations/{conversationId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
