rules_version = '2';

// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Photos uploaded to album buckets.
    // Read: any signed-in user (parents need to see their kids' photos).
    // Write: signed-in + image + size cap. Storage rules can't query Firestore,
    // so the authoritative dept-access check lives on the matching /photos/{id}
    // Firestore rule — a bare upload here without a matching Firestore doc
    // ends up unreferenced.
    match /albums/{albumId}/{photoFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
